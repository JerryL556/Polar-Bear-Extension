{
  "manifest_version": 3,
  "name": "Extension Pet",
  "version": "1.0.0",
  "description": "A bottom-of-page pet with a happiness meter and mood-based behavior.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:4317/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Polar Bear Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "walking-polar-bear.gif",
        "apple.webp",
        "rotten-apple.png",
        "level2a.webp",
        "level3a.jpg",
        "level3b.jpg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
